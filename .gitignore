# Build artifacts
.build/
.swiftpm/
DerivedData/
*.xcarchive/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Node
node_modules/
packages/*/dist/
npm-debug.log*

# Python probe caches
__pycache__/
*.py[cod]

# Local environment and signing credentials
.env
.env.*
!.env.example
!.env.*.example
*.p12
*.p8

# macOS
.DS_Store
._*

# Local AgentSpace runtime (never commit: contains session tokens)
.AgentSpace/

# Test and probe output
*.log
/tmp-probe
/artifacts

# Built app bundles
dist/
*.dmg
*.pkg
.zcode/

# Promo video deliverables ride the GitHub release as assets (digests in
# docs/validation.md §371); the tracked tree keeps the source pipeline only.
marketing/promo/*.mp4
marketing/promo/poster.png

# Mimosa security-scan plugin local state (history, reports, hook state)
.mimosa/
