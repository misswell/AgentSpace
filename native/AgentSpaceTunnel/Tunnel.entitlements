<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>U8U443D7ZL.com.misswell.AgentSpace</string>
    <key>com.apple.developer.team-identifier</key>
    <string>U8U443D7ZL</string>
    <!-- A packet tunnel that is a system extension. Deliberately not the
         app-extension value: that one is App Store only (TN3134). -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider-systemextension</string>
    </array>
    <!-- The extension does its work in a system context; it has no UI and no
         business reading the user's files. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- One group shared by the app and its extension. The POC that activated
         successfully carried this, and the product build without it answered
         "extension category returned error" (§398). It is also how the two
         processes would share state if they ever need to. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>U8U443D7ZL.com.misswell.AgentSpace</string>
    </array>
</dict>
</plist>
