<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The identifiers and the team come from the provisioning profile that
         ships beside this file; carrying them here is what lets the signed
         bundle match the profile exactly. -->
    <key>com.apple.application-identifier</key>
    <string>U8U443D7ZL.com.misswell.AgentSpace</string>
    <key>com.apple.developer.team-identifier</key>
    <string>U8U443D7ZL</string>

    <!-- Permission to install and manage the packet-tunnel system extension.
         Measured the hard way (§398): without it, activation answers
         "Missing entitlement com.apple.developer.system-extension.install". -->
    <key>com.apple.developer.system-extension.install</key>
    <true/>

    <!-- The same entitlement the extension carries. macOS requires the
         containing app to declare every provider type its extension uses. -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider-systemextension</string>
    </array>
    <!-- One group shared by the app and its extension. The POC that activated
         successfully carried this, and the product build without it answered
         "extension category returned error" (§398). It is also how the two
         processes would share state if they ever need to. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>U8U443D7ZL.com.misswell.AgentSpace</string>
    </array>
</dict>
</plist>
